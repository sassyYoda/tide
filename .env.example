POSTGRES_USER=tide
POSTGRES_PASSWORD=tide
POSTGRES_DB=tide
DATABASE_URL=postgresql+asyncpg://tide:tide@db:5432/tide
DATABASE_SYNC_URL=postgresql+psycopg2://tide:tide@db:5432/tide
REDIS_URL=redis://redis:6379/0
# NOAA + Open-Meteo require no auth for free tier
LOG_LEVEL=INFO
PROMETHEUS_MULTIPROC_DIR=/tmp/prom_multiproc

# GCS backup (REL-03) — optional for local dev
GCS_BACKUP_BUCKET=
GCP_SERVICE_ACCOUNT_JSON=
