# WR-06: Non-root user hardening applied below. Digest pinning
# (`python:3.12-slim@sha256:<digest>`) is intentionally DEFERRED to the
# first Renovate/Dependabot-tracked update so the pin is maintained.
#
# The worker shells out to `pg_dump` in the backup task — running that as
# root would mean a compromised pg_dump interaction executes with root
# privileges inside the container. Dropping privileges is defense-in-depth.
FROM python:3.12-slim

# Create an unprivileged user with a real home dir (uv writes its cache to
# $HOME/.cache/uv, so the app user needs a writable home at runtime).
# /celerybeat is pre-created app-owned so the tide_beat named volume
# inherits writable ownership on first mount.
RUN groupadd --system app \
 && useradd --system --gid app --create-home --home-dir /home/app app \
 && mkdir -p /app /celerybeat /tmp/prom_multiproc \
 && chown app:app /app /celerybeat /tmp/prom_multiproc

WORKDIR /app
RUN pip install --no-cache-dir uv
COPY --chown=app:app pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev \
 && chown -R app:app /app/.venv

COPY --chown=app:app . .

USER app
ENV PYTHONPATH=/app \
    UV_CACHE_DIR=/home/app/.cache/uv
CMD ["uv", "run", "celery", "-A", "celery_app", "worker", "--loglevel=info"]
