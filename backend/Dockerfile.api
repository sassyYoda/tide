# WR-06: Non-root user hardening applied below. Digest pinning
# (`python:3.12-slim@sha256:<digest>`) is intentionally DEFERRED to the
# first Renovate/Dependabot-tracked update so the pin is maintained; a
# hand-picked digest here would silently go stale. Track the follow-up
# when configuring Renovate.
FROM python:3.12-slim

# Create an unprivileged user with a real home dir (uv writes its cache to
# $HOME/.cache/uv, so the app user needs a writable home at runtime).
RUN groupadd --system app \
 && useradd --system --gid app --create-home --home-dir /home/app app \
 && mkdir -p /app /tmp/prom_multiproc \
 && chown app:app /app /tmp/prom_multiproc

WORKDIR /app
RUN pip install --no-cache-dir uv
COPY --chown=app:app pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev \
 && chown -R app:app /app/.venv

COPY --chown=app:app . .

USER app
ENV PYTHONPATH=/app \
    UV_CACHE_DIR=/home/app/.cache/uv
EXPOSE 8000
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
